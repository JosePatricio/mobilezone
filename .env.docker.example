# Copy to .env (same folder as docker-compose.yml) and change every value.
# Use only letters and digits in the DB passwords (they are embedded in a URL).

# Local address:port for the app (the host nginx proxies to it). Keep 127.0.0.1 so it is not public.
APP_PORT=127.0.0.1:8081

# MySQL
MYSQL_ROOT_PASSWORD=ChangeRootPassword123
DB_NAME=mobilezone
DB_USER=mobilezone
DB_PASSWORD=ChangeDbPassword123

# Backend security — generate with: openssl rand -base64 48 | tr -d '\n/+='
JWT_SECRET_KEY=replace-with-a-long-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12

# Public URL(s) of the site, JSON list (e.g. ["http://203.0.113.10","https://mobilezone.example.com"])
CORS_ORIGINS=["http://localhost"]

# Initial administrator (only created if it does not exist yet)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeAdminPassword123

UVICORN_WORKERS=2
TZ=UTC
