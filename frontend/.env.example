# Base URL of the API. Leave the default to use the Vite dev proxy (/api -> http://localhost:8000).
VITE_API_BASE_URL=/api/v1
# Public address of the app printed in the work order QR (e.g. https://taller.midominio.com).
# Empty = the address used to open the app. Set it when staff use localhost / a LAN IP.
VITE_PUBLIC_URL=
