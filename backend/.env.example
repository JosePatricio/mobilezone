# MySQL 8.0.16+ or MariaDB 10.4+ (PyMySQL driver). URL-encode special characters in the password.
DATABASE_URL=mysql+pymysql://mobilezone:change-me@localhost:3306/mobilezone?charset=utf8mb4

# Dedicated database for pytest (its name must contain "test"; tables are dropped/recreated).
TEST_DATABASE_URL=mysql+pymysql://mobilezone:change-me@localhost:3306/mobilezone_test?charset=utf8mb4

# Uploaded images (products, user photos). MEDIA_URL can be absolute when the frontend
# is served from another origin, e.g. https://api.example.com/media
MEDIA_DIR=media
MEDIA_URL=/media

# PDF receipts (comprobantes)
COMPANY_NAME=MobileZone
TIMEZONE=America/Guayaquil

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
# "Mantener la sesión iniciada" (login checkbox)
REMEMBER_TOKEN_EXPIRE_DAYS=30
BCRYPT_ROUNDS=12
CORS_ORIGINS=["http://localhost:5173"]

# Initial administrator created by the Python seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
